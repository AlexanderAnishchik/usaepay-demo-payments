# USAePay API credentials
# Copy this file to docker.settings.env and fill in your sandbox values.
# Obtain keys from: Settings → API Keys in the USAePay merchant console.

ASPNETCORE_ENVIRONMENT=Development
USAePay__ApiKey=<your-server-api-key>
USAePay__Pin=<your-hmac-pin>
USAePay__PublicApiKey=<your-public-api-key>
USAePay__BaseUrl=https://sandbox.usaepay.com/api/v2
USAePay__FrontendUrl=http://localhost:3000
